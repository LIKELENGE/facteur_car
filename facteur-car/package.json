  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.19",
    "electron": "^33.0.0",
    "prisma": "^6.19.3",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2"
  }
}
